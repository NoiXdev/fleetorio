# Environment template for running the Docker image in production.
#
# This is NOT loaded automatically - pass these as real environment variables
# to the container (docker-compose `environment:`/`env_file:`, or your
# hoster's equivalent). The image intentionally contains no .env file: see
# docker/entrypoint.sh, which caches config from whatever environment the
# container is actually started with.

APP_NAME=Fuhrparkmanagement
APP_ENV=production
APP_DEBUG=false
# Public URL of this deployment, with scheme. Must match the domain you
# actually serve under, whichever HTTPS path you choose (see README, section
# "Deployment als Docker-Image").
APP_URL=https://fuhrpark.example.com

# ############################################################################
# APP_KEY - DO NOT GENERATE A NEW ONE.
#
# Take this value verbatim from the existing installation's .env
# (the one currently in use, e.g. under DDEV). It encrypts the fuel card
# numbers and two-factor secrets already stored in the database dump you are
# importing. Running `artisan key:generate` here, or leaving this blank and
# letting anything auto-generate one, permanently breaks the ability to
# decrypt that existing data - there is no recovery from that but restoring a
# backup made before the key changed.
# ############################################################################
APP_KEY=

APP_LOCALE=de
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=fuhrpark
DB_USERNAME=fuhrpark
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
# Requires the connection to actually be https - true whenever FrankenPHP
# terminates TLS itself, or a reverse proxy in front of it does. Only leave
# this false while testing locally over plain http.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Real mail sending - without this, the password reset link on the login page
# is accepted but the mail never arrives anywhere.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=fuhrpark@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ############################################################################
# HTTPS: set SERVER_NAME to your real domain (e.g. fuhrpark.example.com) so
# FrankenPHP's built-in Caddy requests and renews a Let's Encrypt certificate
# for it automatically. Requires ports 80 and 443 to reach this container
# directly from the internet (Let's Encrypt's HTTP-01 challenge).
#
# If you instead put a reverse proxy in front of this container (nginx,
# Traefik, your hoster's load balancer, ...) that already terminates HTTPS,
# set SERVER_NAME=":80" here so Caddy just serves plain HTTP on port 80 and
# lets the proxy handle certificates. See README for both paths.
# ############################################################################
SERVER_NAME=fuhrpark.example.com
